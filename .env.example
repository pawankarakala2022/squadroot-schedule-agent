# Copy to .env and fill in. Never commit .env.

# Meta Model API (dev.meta.ai -> API keys)
META_MODEL_API_BASE=https://api.meta.ai/v1
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Open weights (optional): Muse Spark Open on Baseten
OPEN_MODEL_API_BASE=
OPEN_MODEL_API_KEY=
OPEN_MODEL=meta-models/muse-spark-open-1026

# mock = no API calls (tests, judges without a key); meta = Meta Model API; open = open weights
AGENT_MODE=mock
